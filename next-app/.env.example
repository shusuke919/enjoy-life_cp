# お問い合わせフォームのメール送信設定（Resend）
# 本番は Vercel の Project Settings > Environment Variables に登録してください。
# ローカルで試すときは、このファイルを .env.local にコピーして値を入れてください。

# Resend の API キー（https://resend.com/api-keys で発行）
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxx

# 送信元アドレス。Resend で認証済みのドメインである必要があります。
# 例: enjoy life お問い合わせ <noreply@enjoylife-yao.com>
CONTACT_FROM=enjoy life お問い合わせ <noreply@enjoylife-yao.com>

# 送信先（カンマ区切りで複数指定可）。未設定の場合は下記2件が既定値。
CONTACT_TO=rs@enjoylife-yao.com,mk@enjoylife-yao.com
